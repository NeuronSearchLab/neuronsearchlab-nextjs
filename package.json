{
  "name": "@neuronsearchlab/nextjs",
  "version": "0.1.1",
  "description": "Server-first NeuronSearchLab SDK for Next.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@neuronsearchlab/sdk": "^1.20.0",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=14.2.0 <17",
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
